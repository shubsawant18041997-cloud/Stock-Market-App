# Copy this file to .env and fill in what you need. Everything is optional
# except that alerts can't be delivered by email without the SMTP settings.

PORT=4000

# If set, every /api request must send header:  x-api-key: <API_TOKEN>
# Set this before exposing the server to the internet.
API_TOKEN=

# --- Data providers -------------------------------------------------------
# Finnhub free key (https://finnhub.io/register) improves US news + earnings.
# Without it, US/India news comes from Google News RSS and earnings from Yahoo.
FINNHUB_API_KEY=

# Binance public market-data host. data-api.binance.vision is the
# market-data-only mirror and is reachable from most regions.
# Alternatives: https://api.binance.com  or  https://api.binance.us
BINANCE_BASE_URL=https://data-api.binance.vision

# --- Polling --------------------------------------------------------------
QUOTE_POLL_SECONDS=60
NEWS_POLL_SECONDS=600
EARNINGS_POLL_SECONDS=21600
# Only poll stock markets while they are open (crypto is always polled)
RESPECT_MARKET_HOURS=true
# Don't send the same alert rule again within this many minutes
ALERT_COOLDOWN_MINUTES=60

# --- Email (SMTP) ---------------------------------------------------------
# Gmail: smtp.gmail.com / 587, user = your gmail address,
# password = an App Password (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where alerts are emailed (can also be set from the app's Settings screen)
ALERT_EMAIL=
